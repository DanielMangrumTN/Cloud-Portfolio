# ---- Secrets: never commit these ----
.env
.env.*
*.pem
*.key
credentials
.aws/

# ---- Terraform ----
# State files can contain sensitive values; state will live in S3 (Phase 3).
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
crash.log
.terraform.lock.hcl.bak

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# ---- Build output (Lambda zip files, etc.) ----
dist/
*.zip

# ---- Editor / OS clutter ----
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
Desktop.ini
.DS_Store
